# ============================================
# DOCKER DATA - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# ============================================

# PostgreSQL Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# Backend Configuration
REDIS_URL=redis://redis:6379/0

# --- CREDENCIALES PGADMIN ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Backend Configuration
# Generate a new SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_64_character_hex_secret_key_here

# Email Configuration (Gmail SMTP)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Your App Name
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api
NODE_ENV=development

# --- SEGURIDAD Y TOKENS ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# --- CONFIGURACIÓN 2FA ---
TOTP_ISSUER_NAME=Your App Name
ENCRYPTION_KEY=your_fernet_encryption_key_here

# --- SEGURIDAD CLAVE PRIVADA ---
JWT_PRIVATE_KEY_PASSPHRASE=your_rsa_private_key_passphrase_here